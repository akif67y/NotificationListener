# Generate a long random value. Enter the same value in the Android app.
DEVICE_TOKEN=

# Choose heuristic, openai, or gemini. Gemini offers limited free-tier usage.
ANALYSIS_PROVIDER=heuristic

OPENAI_API_KEY=
# A current structured-output-capable model, for example gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# Recommended hosted free-tier model for new Gemini projects.
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated HTTPS origins are optional for a future web dashboard.
CORS_ORIGINS=
